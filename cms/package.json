{
  "name": "sve-za-pecanje-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.20.0 <23" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3002",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:production": "CMS_TEST_SCOPE=production tsx tests/integration.ts",
    "test:compose": "tsx tests/compose.integration.ts",
    "generate": "payload generate:types && payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "db:provision": "tsx scripts/provision.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed": "tsx scripts/seed.ts",
    "storage:provision": "tsx scripts/provision-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "sharp": "0.35.4",
    "graphql": "16.11.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@swc/core"],
    "overrides": { "dompurify": "3.4.15" }
  }
}
