# Copy to .env for direct local commands. Docker uses the workspace .env instead.
CMS_ENV=development
CMS_PUBLIC_URL=http://localhost:3002
CMS_DATABASE_HOST=127.0.0.1
CMS_DATABASE_PORT=5432
# Generate distinct values with: openssl rand -hex 32
CMS_DATABASE_PASSWORD=
CMS_SECRET=
# Only db:provision reads these database-administrator credentials.
CMS_PROVISION_USER=postgres
CMS_PROVISION_PASSWORD=
# Set only for the explicit bootstrap command. Never needed by the web server.
CMS_BOOTSTRAP_EMAIL=
CMS_BOOTSTRAP_PASSWORD=
