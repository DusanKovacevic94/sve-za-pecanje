# Copy to .env for direct local commands. Docker uses the workspace .env instead.
CMS_ENV=development
CMS_PUBLIC_URL=http://localhost:3002
CMS_DATABASE_HOST=127.0.0.1
CMS_DATABASE_PORT=5432
# Generate distinct values with: openssl rand -hex 32
CMS_DATABASE_PASSWORD=
CMS_SECRET=
# Match these two independent 32+ character secrets in the frontend runtime.
CMS_PREVIEW_SECRET=
CMS_REVALIDATE_SECRET=
CMS_FRONTEND_URL=http://localhost:3000
CMS_REVALIDATE_URL=http://localhost:3000/api/blog/revalidate
# Only db:provision reads these database-administrator credentials.
CMS_PROVISION_USER=postgres
CMS_PROVISION_PASSWORD=
# Set only for the explicit bootstrap command. Never needed by the web server.
CMS_BOOTSTRAP_EMAIL=
CMS_BOOTSTRAP_PASSWORD=
# Local Mailpit only; development/test never sends through Resend.
CMS_SMTP_HOST=127.0.0.1
CMS_SMTP_PORT=1025
# Production only: reuse the existing Resend account with CMS-specific configuration.
CMS_RESEND_API_KEY=
CMS_EMAIL_FROM=
# Dedicated CMS bucket and credentials. Never use marketplace or MinIO root keys.
CMS_S3_ENDPOINT=http://127.0.0.1:9000
CMS_S3_REGION=us-east-1
CMS_S3_BUCKET=svezapecanje-cms
CMS_S3_FORCE_PATH_STYLE=true
CMS_S3_PUBLIC_URL=http://localhost:9000/svezapecanje-cms
CMS_S3_ACCESS_KEY_ID=szp-cms
CMS_S3_SECRET_ACCESS_KEY=
# Read only by the explicit LOCAL storage:provision command (requires mc).
CMS_MINIO_ROOT_USER=
CMS_MINIO_ROOT_PASSWORD=
CMS_MARKETPLACE_API_URL=http://localhost:8001/api/v1
