# Copy to .env.production on the VPS and replace every placeholder.
APP_ENV=production
APP_NAME=Sve Za Pecanje
APP_DOMAIN=example.com
APP_URL=https://example.com
API_URL=https://example.com

POSTGRES_DB=fishing_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-admin-password
DATABASE_URL=postgresql+psycopg://fishing_app:replace-with-a-strong-app-password@postgres:5432/fishing_marketplace
REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=ro_session

CORS_ALLOWED_ORIGINS=https://example.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_API_URL=https://example.com/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Sve Za Pecanje <noreply@example.com>
SMTP_HOST=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

NEXT_PUBLIC_ANALYTICS_URL=https://stats.example.com
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=replace-with-website-id
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PHONE_VERIFICATION_ENABLED=false
ACCOUNT_CLOSURE_ENABLED=false
ACCOUNT_CLOSURE_POLICY_APPROVED=false
ABUSE_SIGNAL_RETENTION_DAYS=7
UMAMI_APP_SECRET=replace-with-at-least-32-random-characters
UMAMI_DATABASE_URL=postgresql://umami:replace-with-a-strong-password@postgres:5432/umami

STORAGE_BACKEND=hetzner
HETZNER_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_STORAGE_BUCKET=replace-with-bucket
HETZNER_STORAGE_ROOT_FOLDER=sve-za-pecanje
HETZNER_STORAGE_PUBLIC_URL=https://replace-with-bucket.fsn1.your-objectstorage.com
HETZNER_STORAGE_REGION=eu-central
HETZNER_STORAGE_ACCESS_KEY=replace-with-access-key
HETZNER_STORAGE_SECRET_KEY=replace-with-secret-key
HETZNER_STORAGE_FORCE_PATH_STYLE=false
HETZNER_STORAGE_ACL=public-read
HETZNER_STORAGE_SIGNED_URL_EXPIRES=900

BACKUP_REMOTE=replace-with-rclone-remote:sve-za-pecanje/postgres
BACKUP_INTERVAL_SECONDS=86400

LISTING_REVIEW_MODE=manual
MAX_LISTING_IMAGES=10
MAX_IMAGE_SIZE_MB=8
RATE_LIMIT_ENABLED=true

# Separate CMS identities and purpose-specific secrets; never reuse marketplace keys.
CMS_DATABASE_PASSWORD=replace-with-a-separate-32-character-password
CMS_SECRET=replace-with-a-separate-32-character-cms-secret
CMS_PREVIEW_SECRET=replace-with-a-separate-32-character-preview-secret
CMS_REVALIDATE_SECRET=replace-with-a-separate-32-character-hook-secret
CMS_RESEND_API_KEY=replace-with-cms-resend-key
CMS_EMAIL_FROM=cms@example.com
CMS_S3_ENDPOINT=https://fsn1.your-objectstorage.com
CMS_S3_REGION=eu-central
CMS_S3_BUCKET=replace-with-dedicated-cms-bucket
CMS_S3_FORCE_PATH_STYLE=false
CMS_S3_PUBLIC_URL=https://replace-with-dedicated-cms-bucket.fsn1.your-objectstorage.com
CMS_S3_ACCESS_KEY_ID=replace-with-cms-only-access-key
CMS_S3_SECRET_ACCESS_KEY=replace-with-cms-only-secret-key
BLOG_ANALYTICS_ENABLED=false
BLOG_ANALYTICS_EXCLUDED_POST_IDS=
# Replace with an absolute path to the operator-owned rclone config.
BACKUP_RCLONE_CONFIG=./ops/backup/rclone.conf.example
