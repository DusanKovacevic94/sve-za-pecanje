APP_ENV=development
APP_NAME=Sve Za Pecanje
APP_DOMAIN=svezapecanje.rs
APP_URL=https://svezapecanje.rs
API_URL=http://localhost:8001

POSTGRES_DB=fishing_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fishing_app:change-me@postgres:5432/fishing_marketplace
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-me
JWT_SECRET=change-me
SESSION_COOKIE_NAME=ro_session

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PHONE_VERIFICATION_ENABLED=false
ACCOUNT_CLOSURE_ENABLED=false
ACCOUNT_CLOSURE_POLICY_APPROVED=false
ABUSE_SIGNAL_RETENTION_DAYS=7
UMAMI_APP_SECRET=
UMAMI_DATABASE_URL=postgresql://umami:change-me@postgres:5432/umami

CORS_ALLOWED_ORIGINS=http://localhost:3001,https://svezapecanje.rs
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# Resend (https://resend.com) - when RESEND_API_KEY is set, emails are sent via Resend.
# EMAIL_FROM must use a domain verified in your Resend account, e.g. "Sve Za Pecanje <noreply@vas-domen.rs>".
# When RESEND_API_KEY is empty, emails are only written to the backend log.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=fishing-marketplace
S3_PUBLIC_URL=http://localhost:9000/fishing-marketplace

# Hetzner Object Storage. If these are present, uploads use Hetzner storage.
# STORAGE_BACKEND=hetzner
# HETZNER_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
# HETZNER_STORAGE_BUCKET=fishing-marketplace
# HETZNER_STORAGE_ROOT_FOLDER=sve-za-pecanje
# HETZNER_STORAGE_PUBLIC_URL=https://fishing-marketplace.fsn1.your-objectstorage.com
# HETZNER_STORAGE_REGION=eu-central
# HETZNER_STORAGE_ACCESS_KEY=
# HETZNER_STORAGE_SECRET_KEY=
# HETZNER_STORAGE_FORCE_PATH_STYLE=false
# HETZNER_STORAGE_ACL=public-read
# HETZNER_STORAGE_SIGNED_URL_EXPIRES=900

# Production database backups. BACKUP_REMOTE is an rclone target, e.g.
# hetzner:sve-za-pecanje/postgres or b2:sve-za-pecanje/postgres.
BACKUP_REMOTE=
BACKUP_INTERVAL_SECONDS=86400

LISTING_REVIEW_MODE=manual
MAX_LISTING_IMAGES=10
MAX_IMAGE_SIZE_MB=8

RATE_LIMIT_ENABLED=true

# Optional Payload CMS development overlay (make cms-dev).
# Generate each value independently: openssl rand -hex 32
CMS_DATABASE_PASSWORD=
CMS_SECRET=
# Blog server-to-server configuration. Use independent random 32+ character secrets.
CMS_PREVIEW_SECRET=
CMS_REVALIDATE_SECRET=
# Direct host development only; Compose overrides the internal service addresses.
CMS_INTERNAL_URL=http://127.0.0.1:3002
CMS_FRONTEND_URL=http://localhost:3000
CMS_REVALIDATE_URL=http://localhost:3000/api/blog/revalidate
# Optional CMS image storage; generate another distinct 32-byte random secret.
CMS_S3_ACCESS_KEY_ID=szp-cms
CMS_S3_SECRET_ACCESS_KEY=
CMS_S3_PUBLIC_URL=http://localhost:9000/svezapecanje-cms
# Enable only for real published articles after privacy/release review (off in tests/staging).
BLOG_ANALYTICS_ENABLED=false
# Comma-separated stable CMS post IDs excluded from collection.
BLOG_ANALYTICS_EXCLUDED_POST_IDS=
